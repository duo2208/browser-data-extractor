# 실제 값을 채운 뒤 .env 로 복사하세요. .env 는 커밋 금지(.gitignore 등록됨).
#
#   cp .env.example .env

# --- 필수 ---
TVING_ID=your_tving_id
TVING_PASSWORD=your_password

# --- 선택 ---
# 로그인 유형: tving (티빙 아이디) | cj-one (CJ ONE 연동)
# 아이디만 봐서는 어느 쪽으로 가입했는지 알 수 없어 명시해야 한다.
#
# 값이 틀리면 서비스는 '입력하신 회원정보를 찾을 수 없습니다' 로 응답하는데,
# 이 문구는 비밀번호 오류와 유형 불일치를 구분해 주지 않는다.
# 로그인이 계속 실패하면 반대쪽 값으로도 한 번 시도해 보라.
TVING_LOGIN_TYPE=tving
